@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# 4x RTX 4090 一键复现：并行正确性 + 单卡档位 sweep + 与官方 vLLM 对比。
+#
+# 用法:
+#   cd vllm-v5
+#   bash bench/run_4090_matrix.sh
+#
+# 可覆盖的环境变量:
+#   PY       本项目解释器（默认 python，建议 python）
+#   VLLM_PY  装了官方 vLLM 的解释器（默认空 → 跳过对比，建议 venvs/vllm/bin/python）
+#   OUT      日志路径（默认 /tmp/vllmmin_4090_<时间戳>.log）
+#   N        每次请求输出 token 数（默认 64）
+#   CONC     并发数（默认 8）
+#
+# 例:
+#   PY=python \
+#   VLLM_PY=/root/autodl-tmp/venvs/vllm/bin/python \
+#   bash bench/run_4090_matrix.sh
+set -uo pipefail
+cd "$(dirname "$0")/.."
+
+PY="${PY:-python}"
+VLLM_PY="${VLLM_PY:-}"
+OUT="${OUT:-/tmp/vllmmin_4090_$(date +%Y%m%d_%H%M%S).log}"
+N="${N:-64}"
+CONC="${CONC:-8}"
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export PYTHONPATH=.
+
+run() { echo; echo "===== $* ====="; "$@" 2>&1 | tee -a "$OUT"; }
+
+: >"$OUT"
+echo "interpreter : $PY" | tee -a "$OUT"
+echo "vllm python : ${VLLM_PY:-<unset>}" | tee -a "$OUT"
+echo "log         : $OUT" | tee -a "$OUT"
+
+# --- 0. 环境自检 ---
+run "$PY" -c "import torch, triton, flash_attn, flashinfer; print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.device_count(), 'gpus')"
+
+# --- 1. 正确性 ---
+# unit 无 GPU 也能过；gpu / distributed 需要卡。
+run "$PY" -m pytest tests/unit -q
+run "$PY" -m pytest tests/gpu -q --tb=short -m 'not slow'
+# fp32 golden：tp=2 / pp=2 逐 token 一致（需 >=2 张同型号卡）
+run "$PY" -m pytest tests/distributed/test_dense_parallel.py -q --tb=short
+# MoE tp=2 / tp2+ep 与 tp=1 一致（需 Qwen1.5-MoE-A2.7B）
+run "$PY" -m pytest tests/distributed/test_moe_parallel.py -q --tb=short
+
+# --- 2. 单卡 4090: Qwen3-0.6B  eager / cg / cg+compile ---
+# 逐张卡各扫一遍，方便挑空闲卡，也便于看卡间波动。
+for d in 0 1 2 3; do
+  run "$PY" bench/single_card_sweep.py --device "$d" --model dense --n "$N"
+done
+
+# --- 3. 与官方 vLLM 对比: TP=1 / TP=4，单并发 + 并发批 ---
+if [[ -n "$VLLM_PY" ]]; then
+  for c in 1 "$CONC"; do
+    run "$PY" bench/vs_vllm.py --model dense --devices 0 --tp 1 \
+        --concurrency "$c" --n "$N" --vllm-python "$VLLM_PY"
+    run "$PY" bench/vs_vllm.py --model dense --devices 0,1,2,3 --tp 4 \
+        --concurrency "$c" --n "$N" --vllm-python "$VLLM_PY"
+  done
+  # MoE（Qwen1.5-MoE-A2.7B）TP=2 + EP
+  run "$PY" bench/vs_vllm.py --model moe --devices 0,1 --tp 2 --ep \
+      --n "$N" --vllm-python "$VLLM_PY"
+else
+  echo "[skip] 官方 vLLM 对比：设 VLLM_PY=<venv>/bin/python 后重跑" | tee -a "$OUT"
+fi
+
+echo; echo "done -> $OUT" | tee -a "$OUT"
diff --git a/vllm-v5/bench/single_card_sweep.py b/vllm-v5/bench/single_card_sweep.py
new file mode 100644
index 0000000..4cd215e
--- /dev/null
+++ b/vllm-v5/bench/single_card_sweep.py
@@ -0,0 +1,133 @@
+"""Single-GPU sweep: eager vs Decode CUDA Graph vs CG+prefill compile.
+
+每档在**独立子进程**里跑 ``bench/moe_e2e.py --json``（避免 CUDA Graph / compile
+状态互相污染），最后汇总成 Markdown 表。单卡 Qwen3-0.6B 的
+``e2e tok/s`` 与 ``vs eager`` 一列，就是简历里「×× tok/s、较 Eager 提升 ×」的口径。
+
+用法（在 vllm-v5/ 下）::
+
+    export CUDA_DEVICE_ORDER=PCI_BUS_ID PYTHONPATH=.
+    python bench/single_card_sweep.py --device 0                 # Qwen3-0.6B
+    python bench/single_card_sweep.py --device 1 --model moe     # MoE 档位
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+CELLS: tuple[tuple[str, list[str]], ...] = (
+    ("eager", ["--eager"]),
+    ("cg", ["--cg"]),
+    ("cg+compile", ["--cg", "--compile"]),
+)
+
+
+def _run_cell(
+    *,
+    device: int,
+    cell_args: list[str],
+    model: str,
+    n: int,
+    warmup: int,
+    reps: int,
+    backend: str,
+) -> dict:
+    env = os.environ.copy()
+    env["CUDA_DEVICE_ORDER"] = "PCI_BUS_ID"
+    env["CUDA_VISIBLE_DEVICES"] = str(device)
+    root = str(ROOT)
+    env["PYTHONPATH"] = root + (
+        os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else ""
+    )
+    cmd = [
+        sys.executable,
+        "bench/moe_e2e.py",
+        "--model",
+        model,
+        "--devices",
+        "0",
+        "--n",
+        str(n),
+        "--warmup",
+        str(warmup),
+        "--reps",
+        str(reps),
+        "--moe-backend",
+        backend,
+        "--json",
+        *cell_args,
+    ]
+    proc = subprocess.run(
+        cmd, cwd=root, env=env, capture_output=True, text=True, timeout=7200
+    )
+    if proc.returncode != 0:
+        raise RuntimeError(
+            f"cell {cell_args} failed (device={device})\n"
+            f"stdout:\n{proc.stdout}\nstderr:\n{proc.stderr}"
+        )
+    lines = [ln for ln in proc.stdout.splitlines() if ln.strip().startswith("{")]
+    if not lines:
+        raise RuntimeError(f"no JSON from cell {cell_args}\n{proc.stdout}")
+    return json.loads(lines[-1])
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--device", type=int, default=0, help="物理 GPU 号（可用 nvidia-smi 查）")
+    ap.add_argument("--model", choices=("dense", "moe"), default="dense")
+    ap.add_argument("--n", type=int, default=64)
+    ap.add_argument("--warmup", type=int, default=2)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--moe-backend", default="triton")
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args()
+
+    rows: list[tuple[str, dict]] = []
+    for label, extra in CELLS:
+        r = _run_cell(
+            device=args.device,
+            cell_args=extra,
+            model=args.model,
+            n=args.n,
+            warmup=args.warmup,
+            reps=args.reps,
+            backend=args.moe_backend,
+        )
+        rows.append((label, r))
+        print(f"[ok] {label}: {r['e2e_tok_s']:.1f} tok/s", flush=True)
+
+    base = rows[0][1]
+    if args.json:
+        print(
+            json.dumps(
+                {
+                    "model": args.model,
+                    "device": args.device,
+                    "n": args.n,
+                    "cells": {label: r for label, r in rows},
+                },
+                ensure_ascii=False,
+            )
+        )
+        return
+
+    print(f"\n# 单卡 sweep — model={args.model} device={args.device} n={args.n}\n")
+    print("| 档位 | e2e tok/s | decode tok/s | TTFT ms | TPOT ms | vs eager |")
+    print("|---|---:|---:|---:|---:|---:|")
+    for label, r in rows:
+        speed = r["e2e_tok_s"] / base["e2e_tok_s"] if base["e2e_tok_s"] else float("nan")
+        print(
+            f"| {label} | {r['e2e_tok_s']:.1f} | {r['decode_tok_s']:.1f} | "
+            f"{r['ttft_ms']:.2f} | {r['tpot_ms']:.3f} | {speed:.2f}x |"
+        )
+
+
+if __name__ == "__main__":
+    main()
