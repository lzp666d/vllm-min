diff --git a/vllm-v3/config.yaml b/vllm-v3/config.yaml
index 9b06253..159cfe7 100644
--- a/vllm-v3/config.yaml
+++ b/vllm-v3/config.yaml
@@ -29,6 +29,23 @@ max_num_seqs: 256
 max_num_batched_tokens: 8192
 mix_prefill_decode: true
 
+# --- chunked prefill（参数语义对齐 vLLM SchedulerConfig）---
+# max_prefill_chunk: 单个 prefill chunk 的 token 上限（vLLM: long_prefill_token_threshold）
+#   0    = 不主动切分，chunk 只受 max_num_batched_tokens 约束（v3 原行为）
+#   1024 = 主动切片：按 context_len/4 取（4096/4），且是 kvcache_block_size(256) 的整数倍（页对齐）
+#   效果：长 prompt 跨多步算完，decode 每步都能插进来，ITL 更平稳
+max_prefill_chunk: 1024
+# 每步最多允许几个"未完成"prefill（vLLM: max_num_partial_prefills）
+max_num_partial_prefills: 1
+# 其中"长请求"（prompt > max_prefill_chunk）的未完成 prefill 上限（vLLM: max_long_partial_prefills）
+max_long_partial_prefills: 1
+
+# Sarathi 式"每步 prefill 总配额"：限制整步的 prefill 工作量（而非单个请求）。
+#   0    = 关闭（vLLM 模式：每请求 cap + 半截数量上限；步长无显式上界）
+#   2048 = 一步最多往 prefill 花 2048 token，并按"公平份额"分给本步的多个请求
+#          → 步长上界 = decode 数 + 2048（ITL 可控），且一步可推进多个长请求
+max_prefill_tokens_per_step: 2048
+
 # --- KV Cache ---
 kvcache_block_size: 256  # FA2 paged 要求 256 的倍数
 prefix_backend: "hash"   # none / hash / radix
